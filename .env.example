# =============================================================================
#  Le Jardin de Régina — modèle de configuration
#
#  Copier ce fichier en ".env" puis lancer : php artisan key:generate
#  Le fichier .env n'est jamais envoyé sur GitHub (il contient des mots de passe).
#  Les valeurs ci-dessous conviennent au poste de développement (XAMPP).
#  Les lignes « En ligne : » indiquent la valeur à mettre sur le serveur de production.
# =============================================================================

APP_NAME="Le Jardin de Régina"
# En ligne : production
APP_ENV=local
APP_KEY=
# En ligne : false (sinon les erreurs détaillées, mots de passe compris, s'affichent aux visiteurs)
APP_DEBUG=true
APP_TIMEZONE=Europe/Paris
# En ligne : l'adresse exacte du site, en https et sans « / » final (ex. https://www.jardinderegina.fr)
# Elle sert aux liens des emails, au plan du site (sitemap.xml) et à Google.
APP_URL=http://localhost:8000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
# En ligne : daily (un fichier par jour, gardé 14 jours)
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# En ligne : warning
LOG_LEVEL=debug

# Base MySQL (XAMPP en local ; identifiants fournis par l'hébergeur en ligne)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=jardin_de_regina
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
# Déconnexion de l'admin à la fermeture du navigateur
SESSION_EXPIRE_ON_CLOSE=true
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# En ligne : true (le cookie de session ne circule qu'en https)
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# Emails
# En local : « log » = les emails sont écrits dans storage/logs/laravel.log, rien n'est envoyé.
# En ligne (Brevo) : MAIL_MAILER=smtp, MAIL_SCHEME=smtp, MAIL_HOST=smtp-relay.brevo.com, MAIL_PORT=587,
#                    MAIL_USERNAME et MAIL_PASSWORD = identifiant et clé SMTP fournis par Brevo.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
# Expéditeur des emails (en ligne : une adresse du nom de domaine du site, validée dans Brevo)
MAIL_FROM_ADDRESS="jardinderegina94@gmail.com"
MAIL_FROM_NAME="${APP_NAME}"
# Adresse qui reçoit les alertes « nouvelle demande » envoyées à la direction
MAIL_ADMIN_ADDRESS="jardinderegina94@gmail.com"

VITE_APP_NAME="${APP_NAME}"
